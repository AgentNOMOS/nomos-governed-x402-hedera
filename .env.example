# NOMOS Governed x402 on Hedera — example environment
#
# ─────────────────────────────────────────────────────────────────────────────
#  THIS FILE CONTAINS PLACEHOLDERS ONLY.
#  Never commit a filled-in copy. Copy to `.env` (git-ignored) and fill locally.
#  No value in this file is, or has ever been, a real credential.
# ─────────────────────────────────────────────────────────────────────────────
#
# All identifiers below MUST be freshly created for this demo:
#   - a NEW Hedera *testnet* account from https://portal.hedera.com/ (faucet)
#   - a NEW HCS topic created by this project (CP-H7)
#   - a NEW throwaway Ed25519 receipt-signing key (CP-H6)
# Reusing any pre-existing operator account, topic or signing key is forbidden
# — see docs/SECURITY_BOUNDARIES.md.

# ── Network (fixed: testnet only, enforced in code) ──────────────────────────
NOMOS_GX402_NETWORK=hedera:testnet
NOMOS_GX402_MIRROR_URL=https://testnet.mirrornode.hedera.com/api/v1
NOMOS_GX402_HASHSCAN_BASE=https://hashscan.io/testnet

# ── Resource server (holds NO Hedera key — it never signs a payment) ─────────
NOMOS_GX402_PORT=4402
# Receiver account id only. Format 0.0.<num>. Never a private key.
NOMOS_GX402_PAY_TO=0.0.CHANGEME
NOMOS_GX402_FACILITATOR_URL=https://api.testnet.blocky402.com

# ── Agent client (the ONLY component that holds a payer key) ─────────────────
# Account id of the funded testnet payer.
NOMOS_GX402_PAYER_ACCOUNT_ID=0.0.CHANGEME
# Private key of that payer. MUST stay empty in this file. The key is read by
# the isolated signer process only — never by the agent, LLM, UI, receipt or log.
NOMOS_GX402_PAYER_PRIVATE_KEY=
# ECDSA_SECP256K1 | ED25519 — decides fromStringECDSA vs fromStringED25519
NOMOS_GX402_PAYER_KEY_TYPE=ECDSA_SECP256K1

# ── Receipt signing (throwaway demo key, CP-H6) ──────────────────────────────
# Path to a PKCS#8 PEM Ed25519 private key generated by `npm run keygen`.
# The file itself is git-ignored. Never point this at a production key path.
NOMOS_GX402_RECEIPT_SIGNING_KEY_PATH=./.local/receipt-signer.key
NOMOS_GX402_RECEIPT_SIGNING_KID=nomos-gx402-demo-ed25519-1

# ── HCS anchoring (CP-H7) ────────────────────────────────────────────────────
# Topic created by this project. Leave empty until CP-H7 creates one.
# NEVER set this to 0.0.10420280 / 0.0.10420282 / 0.0.8510520 / 0.0.8510521.
NOMOS_GX402_HCS_TOPIC_ID=
NOMOS_GX402_ANCHOR_ENABLED=false

# ── Demo spend guardrails (see packages/nomos-policy) ────────────────────────
# Atomic units (tinybar for HBAR). Integers only — never floats.
NOMOS_GX402_MAX_ATOMIC_PER_PAYMENT=10000000
NOMOS_GX402_MAX_ATOMIC_CUMULATIVE=200000000
NOMOS_GX402_MAX_PAYMENTS_PER_UTC_DAY=50
NOMOS_GX402_QUOTE_TTL_SECONDS=180
