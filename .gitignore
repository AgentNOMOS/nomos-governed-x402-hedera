# ── Secrets: never, under any circumstance ──────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.der
*.jks
*.keystore
id_ed25519*
id_ecdsa*
id_rsa*
*private*key*
*privatekey*
*secret*
# The three files of the secret SCANNER are not secrets — they are the thing
# that finds them. `*secret*` above swallowed all three, so a fresh clone got
# no scanner, no waiver list and no test for either. Re-included by exact path
# only: a new *secret* file anywhere still stays ignored by default.
!tools/secret-scan.ts
!tools/secret-scan.allow.json
!tests/unit/secret-scan.test.ts
*.seed
*mnemonic*
wallet.json
wallets/
*wallet*.json
!*.example.json
.hedera-*
operator.json
.local/
keys/
secrets/

# ── Generated receipts / anchors: may embed account ids, tx ids, hashes ─────
# Only fixtures under tests/**/fixtures/ and docs/evidence/ are tracked, and
# those must be synthetic. Runtime output is never committed.
out/
runtime/
receipts/
anchors/
*.receipt.json
*.anchor.json

# ── Local logs ──────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-error.log*
.secret-scan-report.json

# ── Dependencies / build output ─────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
.tsbuildinfo
*.tsbuildinfo
.cache/

# ── Editor / OS noise ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
