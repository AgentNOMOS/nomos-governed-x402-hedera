{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomos.example/schemas/gx402/payment_challenge.v1.json",
  "title": "NOMOS GX402 Payment Challenge v1",
  "description": "The body served alongside HTTP 402. `accepts` mirrors the x402 shape; `nomos` carries the governance binding that plain x402 has no place for.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "x402_version",
    "accepts",
    "nomos"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "nomos.gx402.payment_challenge.v1"
    },
    "x402_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "accepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scheme",
          "network",
          "asset",
          "atomic_amount",
          "pay_to",
          "max_timeout_seconds",
          "resource"
        ],
        "properties": {
          "scheme": {
            "type": "string",
            "const": "exact"
          },
          "network": {
            "type": "string",
            "const": "hedera:testnet",
            "description": "Pinned to Hedera testnet. Mainnet documents are unrepresentable by construction."
          },
          "asset": {
            "type": "string",
            "pattern": "^(HBAR|[0-9]+\\.[0-9]+\\.[0-9]+)$",
            "description": "HBAR, or an HTS token id in shard.realm.num form."
          },
          "atomic_amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact amount the payer must transfer."
          },
          "pay_to": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "Receiver account id."
          },
          "max_timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "resource": {
            "type": "string",
            "minLength": 8,
            "maxLength": 512
          },
          "memo": {
            "type": "string",
            "maxLength": 100,
            "description": "MUST be set to quote_id. This is the on-chain link between the transfer and the quote — the field a verifier reads back from the mirror node."
          }
        }
      }
    },
    "nomos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "quote_hash",
        "request_hash",
        "idempotency_key",
        "issued_at",
        "expires_at",
        "decision_id"
      ],
      "properties": {
        "quote_id": {
          "type": "string",
          "pattern": "^q_[0-9a-f]{24}$"
        },
        "quote_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Digest of the quote object."
        },
        "request_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Digest of the request body this quote is valid for."
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^idem_[0-9a-f]{32}$"
        },
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "description": "Quote issue time."
        },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "description": "Hard expiry. Past this the server refuses fail-closed."
        },
        "decision_id": {
          "type": "string",
          "pattern": "^ppd_[0-9a-f]{24}$"
        }
      }
    }
  }
}
