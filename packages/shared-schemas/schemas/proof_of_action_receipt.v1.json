{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomos.example/schemas/gx402/proof_of_action_receipt.v1.json",
  "title": "NOMOS GX402 Proof-of-Action Receipt v1",
  "description": "The deliverable. Binds identity, authority, policy decision, request, quote, payment and delivery into one signed, independently verifiable record. Contains hashes only — never request or result content, never personal data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_version",
    "receipt_id",
    "record",
    "record_digest",
    "signature"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "nomos.gx402.proof_of_action_receipt.v1"
    },
    "receipt_version": {
      "type": "string",
      "const": "v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^poa_[0-9a-f]{24}$"
    },
    "record_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Digest over `record`. This is the value that gets anchored to HCS."
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "kid",
        "signature_domain",
        "canonicalization",
        "public_key_hex",
        "signature"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "const": "Ed25519"
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Key id. A verifier MUST resolve this against a published key set rather than trusting public_key_hex."
        },
        "signature_domain": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "canonicalization": {
          "type": "string",
          "const": "RFC8785-JCS/nomos-int-only-v1"
        },
        "public_key_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "description": "base64 Ed25519 signature."
        }
      }
    },
    "anchor": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://nomos.example/schemas/gx402/hcs_anchor_reference.v1.json",
      "title": "NOMOS GX402 HCS Anchor Reference v1",
      "description": "Proof that a receipt digest was submitted to a Hedera Consensus Service topic. Anchoring is ADDITIVE: a receipt without an anchor is still fully valid.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source",
        "status",
        "network",
        "anchored_digest"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "const": "nomos.gx402.hcs_anchor_reference.v1"
        },
        "source": {
          "type": "string",
          "enum": [
            "MOCK_OFFLINE",
            "HEDERA_HCS"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ANCHORED",
            "PENDING",
            "FAILED"
          ]
        },
        "network": {
          "type": "string",
          "const": "hedera:testnet",
          "description": "Pinned to Hedera testnet. Mainnet documents are unrepresentable by construction."
        },
        "anchored_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "MUST equal the receipt's record_digest."
        },
        "topic_id": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Topic the message was submitted to.",
          "nullable": true
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 1,
          "nullable": true
        },
        "transaction_id": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+@[0-9]+\\.[0-9]+$",
          "nullable": true
        },
        "consensus_timestamp": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "nullable": true
        },
        "anchored_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "description": "Local submit time.",
          "nullable": true
        },
        "hashscan_url": {
          "type": "string",
          "maxLength": 512,
          "nullable": true
        },
        "mirror_url": {
          "type": "string",
          "maxLength": 512,
          "nullable": true
        },
        "failure_code": {
          "type": "string",
          "maxLength": 64,
          "nullable": true
        }
      },
      "nullable": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hashscan_transaction_url"
      ],
      "description": "Human-checkable links. Derived, never authoritative — the hashes are.",
      "properties": {
        "hashscan_transaction_url": {
          "type": "string",
          "maxLength": 512
        },
        "hashscan_topic_url": {
          "type": "string",
          "maxLength": 512,
          "nullable": true
        },
        "mirror_transaction_url": {
          "type": "string",
          "maxLength": 512,
          "nullable": true
        },
        "mirror_topic_message_url": {
          "type": "string",
          "maxLength": 512,
          "nullable": true
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_identity",
        "authority_scope",
        "service_identity",
        "offer_id",
        "policy_decision",
        "policy_version",
        "policy_hash",
        "decision_id",
        "request_hash",
        "quote_id",
        "quote_hash",
        "idempotency_key",
        "nonce",
        "network",
        "asset",
        "atomic_amount",
        "payer",
        "payee",
        "hedera_transaction_id",
        "settlement_source",
        "settlement_finality",
        "execution_status",
        "delivery_status",
        "result_hash",
        "receipt_timestamp",
        "environment",
        "disclaimer"
      ],
      "properties": {
        "agent_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "did",
            "public_key_hex",
            "key_type"
          ],
          "description": "Who is acting. No human names, no emails, no free text.",
          "properties": {
            "did": {
              "type": "string",
              "minLength": 8,
              "maxLength": 256,
              "description": "Stable agent identifier, e.g. did:key:z…"
            },
            "public_key_hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Raw Ed25519 public key of the agent."
            },
            "key_type": {
              "type": "string",
              "const": "Ed25519"
            },
            "label": {
              "type": "string",
              "maxLength": 64,
              "description": "Optional non-identifying display label."
            }
          }
        },
        "authority_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scopes",
            "granted_by",
            "valid_until"
          ],
          "description": "What the agent was authorised to do, and by whom, and until when.",
          "properties": {
            "scopes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_]+:[a-z0-9_*]+$"
              },
              "description": "Capability strings such as evidence:read."
            },
            "granted_by": {
              "type": "string",
              "minLength": 8,
              "maxLength": 256,
              "description": "DID of the granting authority."
            },
            "valid_until": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "description": "Delegation expiry. Past expiry the policy denies fail-closed."
            },
            "delegation_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "Optional digest of the full delegation document.",
              "nullable": true
            }
          }
        },
        "service_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service_id",
            "resource_url",
            "http_method"
          ],
          "properties": {
            "service_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128
            },
            "resource_url": {
              "type": "string",
              "minLength": 8,
              "maxLength": 512
            },
            "http_method": {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            }
          }
        },
        "offer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_decision": {
          "type": "string",
          "enum": [
            "ALLOW",
            "DENY",
            "REVIEW"
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "policy_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Digest of the effective policy document."
        },
        "decision_id": {
          "type": "string",
          "pattern": "^ppd_[0-9a-f]{24}$"
        },
        "request_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Canonical digest of the request body."
        },
        "quote_id": {
          "type": "string",
          "pattern": "^q_[0-9a-f]{24}$"
        },
        "quote_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Canonical digest of the quote."
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^idem_[0-9a-f]{32}$"
        },
        "nonce": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "network": {
          "type": "string",
          "const": "hedera:testnet",
          "description": "Pinned to Hedera testnet. Mainnet documents are unrepresentable by construction."
        },
        "asset": {
          "type": "string",
          "pattern": "^(HBAR|[0-9]+\\.[0-9]+\\.[0-9]+)$",
          "description": "HBAR, or an HTS token id in shard.realm.num form."
        },
        "atomic_amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Amount settled, in atomic units, as a decimal string."
        },
        "payer": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Paying account, as debited on the ledger."
        },
        "payee": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Receiving account, as credited on the ledger. Never an alias: a receipt names the account that exists, not the address it was created from."
        },
        "hedera_transaction_id": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+@[0-9]+\\.[0-9]+$"
        },
        "consensus_timestamp": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "nullable": true
        },
        "settlement_source": {
          "type": "string",
          "enum": [
            "MOCK_OFFLINE",
            "MIRROR_NODE"
          ]
        },
        "settlement_finality": {
          "type": "string",
          "enum": [
            "FINAL",
            "PENDING",
            "FAILED"
          ]
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "delivery_status": {
          "type": "string",
          "enum": [
            "DELIVERED",
            "NOT_DELIVERED"
          ]
        },
        "result_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Canonical digest of the delivered result."
        },
        "refund_due": {
          "type": "boolean"
        },
        "receipt_timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "description": "When this receipt was assembled."
        },
        "environment": {
          "type": "string",
          "const": "TESTNET_DEMO_ONLY"
        },
        "disclaimer": {
          "type": "string",
          "minLength": 8,
          "maxLength": 512
        }
      }
    }
  }
}
